[debug] [2026-05-15T23:18:42.033Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/daily-collection-management/rulesets {"name":"projects/daily-collection-management/rulesets/0f370205-2b78-4fe2-98d3-f629816039fd","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function hasUserDoc(uid) {\n      return exists(/databases/$(database)/documents/users/$(uid));\n    }\n\n    function hasRole(role) {\n      return signedIn()\n        && hasUserDoc(request.auth.uid)\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;\n    }\n\n    function isAdmin() {\n      return hasRole('admin');\n    }\n\n    function isCollector() {\n      return hasRole('collector');\n    }\n\n    function ownsUserDoc(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function customerAssignedTo(customerId, uid) {\n      return get(/databases/$(database)/documents/customers/$(customerId)).data.assignedCollectorId == uid;\n    }\n\n    function customerBalanceOnlyChanged() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'totalSavings',\n        'totalSavingsPaise',\n        'pendingAmount',\n        'pendingAmountPaise',\n        'pendingDays',\n        'overdueDays',\n        'penaltyAmount',\n        'penaltyAmountPaise',\n        'lastCollectionDate',\n        'lastDailySyncDate',\n        'lastPenaltyUpdated',\n        'updatedAt'\n      ]);\n    }\n\n    function loanOperationalOnlyChanged() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'totalPaid',\n        'totalPaidPaise',\n        'remainingBalance',\n        'remainingBalancePaise',\n        'paidInstallments',\n        'loanStatus',\n        'lastEMIPaymentDate',\n        'nextDueDate',\n        'dueDate',\n        'overdueDays',\n        'penaltyAmount',\n        'penaltyAmountPaise',\n        'lastPenaltyUpdated',\n        'updatedAt'\n      ]);\n    }\n\n    match /users/{userId} {\n      allow read: if isAdmin() || ownsUserDoc(userId);\n      allow create: if isAdmin()\n        || (\n          ownsUserDoc(userId)\n          && request.resource.data.role == 'collector'\n          && request.resource.data.status == 'active'\n        );\n      allow update: if isAdmin()\n        || (\n          ownsUserDoc(userId)\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'fullName',\n            'mobile',\n            'profileImage',\n            'email',\n            'lastLogin',\n            'updatedAt'\n          ])\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /customers/{customerId} {\n      allow read: if isAdmin()\n        || (isCollector() && resource.data.assignedCollectorId == request.auth.uid);\n      allow create: if isAdmin();\n      allow update: if isAdmin()\n        || (\n          isCollector()\n          && resource.data.assignedCollectorId == request.auth.uid\n          && customerBalanceOnlyChanged()\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /dailyCollections/{collectionId} {\n      allow read: if isAdmin()\n        || (isCollector() && resource.data.collectorId == request.auth.uid);\n      allow create: if signedIn()\n        && collectionId == request.resource.data.customerId + '_' + request.resource.data.date\n        && !exists(/databases/$(database)/documents/dailyCollections/$(collectionId))\n        && (\n          isAdmin()\n          || (\n            isCollector()\n            && request.resource.data.collectorId == request.auth.uid\n            && customerAssignedTo(request.resource.data.customerId, request.auth.uid)\n          )\n        );\n      allow update, delete: if isAdmin();\n    }\n\n    match /loans/{loanId} {\n      allow read: if isAdmin()\n        || (isCollector() && customerAssignedTo(resource.data.customerId, request.auth.uid));\n      allow create, delete: if isAdmin();\n      allow update: if isAdmin()\n        || (\n          isCollector()\n          && customerAssignedTo(resource.data.customerId, request.auth.uid)\n          && loanOperationalOnlyChanged()\n        );\n    }\n\n    match /emiPayments/{paymentId} {\n      allow read: if isAdmin()\n        || (isCollector() && resource.data.collectorId == request.auth.uid);\n      allow create: if isAdmin()\n        || (\n          isCollector()\n          && request.resource.data.collectorId == request.auth.uid\n          && customerAssignedTo(request.resource.data.customerId, request.auth.uid)\n        );\n      allow update, delete: if isAdmin();\n    }\n\n    match /notifications/{notificationId} {\n      allow read: if isAdmin()\n        || (signedIn() && resource.data.userId == request.auth.uid);\n      allow create, delete: if isAdmin();\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && resource.data.userId == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'isRead',\n            'readAt'\n          ])\n        );\n    }\n\n    match /dailySummaries/{summaryId} {\n      allow read: if isAdmin()\n        || (isCollector() && resource.data.collectorId == request.auth.uid);\n      allow create, update: if isAdmin()\n        || (\n          isCollector()\n          && request.resource.data.collectorId == request.auth.uid\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /penalties/{penaltyId} {\n      allow read: if isAdmin()\n        || (isCollector() && resource.data.collectorId == request.auth.uid);\n      allow create, update: if isAdmin()\n        || (\n          isCollector()\n          && request.resource.data.collectorId == request.auth.uid\n          && request.resource.data.type in ['daily', 'emi']\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /systemCounters/{counterId} {\n      allow read, create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n  }\n}\n","name":"firebase/firestore.rules"}]},"createTime":"2026-05-15T23:18:41.060575Z","metadata":{"services":["cloud.firestore"]}}
