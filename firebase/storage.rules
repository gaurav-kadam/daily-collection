rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid));
    }

    function hasRole(role) {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function customerAssignedTo(customerId, uid) {
      return firestore.get(/databases/(default)/documents/customers/$(customerId)).data.assignedCollectorId == uid;
    }

    match /customerPhotos/{customerId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && customerAssignedTo(customerId, request.auth.uid));
      allow create, update: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
  }
}
