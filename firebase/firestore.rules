rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return isAuthenticated();
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function requesterUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveUserStatus() {
      return hasUserDoc(request.auth.uid)
        && (
          !requesterUser().keys().hasAny(['status'])
          || requesterUser().status == 'active'
        );
    }

    function hasRole(role) {
      return isAuthenticated()
        && hasUserDoc(request.auth.uid)
        && hasActiveUserStatus()
        && requesterUser().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCollector() {
      return hasRole('collector');
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function customerAssignedTo(customerId, uid) {
      return get(/databases/$(database)/documents/customers/$(customerId)).data.assignedCollectorId == uid;
    }

    function canAccessCustomer(customerId) {
      return isAdmin() || (isCollector() && customerAssignedTo(customerId, request.auth.uid));
    }

    function customerMasterOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullName',
        'shopName',
        'shopNameLower',
        'ownerName',
        'ownerNameLower',
        'mobile',
        'mobileSearch',
        'alternateMobile',
        'alternateMobileSearch',
        'address',
        'area',
        'areaLower',
        'aadhaarNumber',
        'panNumber',
        'gender',
        'dateOfBirth',
        'occupation',
        'kyc',
        'profilePhoto',
        'profilePhotoUrl',
        'documentPhoto',
        'documentPhotoUrl',
        'photo',
        'photoUrl',
        'assignedCollectorId',
        'assignedCollectorName',
        'status',
        'joiningDate',
        'idProofType',
        'idProofNumber',
        'notes',
        'searchKeywords',
        'moduleFlags',
        'totalSavings',
        'totalSavingsPaise',
        'pendingAmount',
        'pendingAmountPaise',
        'pendingDays',
        'overdueDays',
        'penaltyAmount',
        'penaltyAmountPaise',
        'dailyAmount',
        'dailyAmountPaise',
        'emiDue',
        'maturityAmount',
        'totalCollected',
        'totalCollectedPaise',
        'loanBalance',
        'loanBalancePaise',
        'dailyCollectionTotals',
        'loanStatus',
        'activeLoanId',
        'lastCollectionDate',
        'lastDailySyncDate',
        'lastPenaltyUpdated',
        'updatedAt'
      ]);
    }

    function hasNoCustomerFinanceFields(data) {
      return !data.keys().hasAny([
        'totalSavings',
        'totalSavingsPaise',
        'pendingAmount',
        'pendingAmountPaise',
        'pendingDays',
        'overdueDays',
        'penaltyAmount',
        'penaltyAmountPaise',
        'dailyAmount',
        'dailyAmountPaise',
        'emiDue',
        'maturityAmount',
        'totalCollected',
        'loanBalance',
        'dailyCollectionTotals',
        'loanStatus',
        'activeLoanId',
        'lastCollectionDate',
        'lastDailySyncDate',
        'lastPenaltyUpdated'
      ]);
    }

    function hasValidModuleFlags(moduleFlags) {
      return moduleFlags is map
        && moduleFlags.keys().hasOnly([
          'bachat',
          'dailyCollection',
          'saving',
          'loan',
          'bishi',
          'fd',
          'deposit'
        ])
        && moduleFlags.bachat is bool
        && moduleFlags.dailyCollection is bool
        && moduleFlags.saving is bool
        && moduleFlags.loan is bool
        && moduleFlags.bishi is bool
        && moduleFlags.fd is bool
        && moduleFlags.deposit is bool;
    }

    function loanOperationalOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'totalPaid',
        'totalPaidPaise',
        'remainingBalance',
        'remainingBalancePaise',
        'paidInstallments',
        'loanStatus',
        'lastEMIPaymentDate',
        'nextDueDate',
        'dueDate',
        'overdueDays',
        'penaltyAmount',
        'penaltyAmountPaise',
        'lastPenaltyUpdated',
        'updatedAt'
      ]);
    }

    function userSelfEditableFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullName',
        'mobile',
        'profileImage',
        'email',
        'lastLogin',
        'updatedAt',
        'permissions',
        'role',
        'status'
      ]);
    }

    function selfRoleStatusBackfillOnly() {
      return (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (
            request.resource.data.role == 'collector'
            && !resource.data.keys().hasAny(['role'])
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            request.resource.data.status == 'active'
            && !resource.data.keys().hasAny(['status'])
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
          || !resource.data.keys().hasAny(['permissions'])
        );
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsUserDoc(userId);
      allow create: if isAdmin()
        || (
          ownsUserDoc(userId)
          && request.resource.data.role == 'collector'
          && request.resource.data.status == 'active'
        );
      allow update: if isAdmin()
        || (
          ownsUserDoc(userId)
          && userSelfEditableFieldsOnly()
          && selfRoleStatusBackfillOnly()
        );
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.assignedCollectorId == request.auth.uid);
      allow create: if isAdmin()
        && hasNoCustomerFinanceFields(request.resource.data)
        && hasValidModuleFlags(request.resource.data.moduleFlags);
      allow update: if isAdmin()
        && customerMasterOnlyChanged()
        && hasNoCustomerFinanceFields(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moduleFlags'])
          || hasValidModuleFlags(request.resource.data.moduleFlags)
        )
        || (
          isCollector()
          && resource.data.assignedCollectorId == request.auth.uid
          && customerMasterOnlyChanged()
          && hasNoCustomerFinanceFields(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moduleFlags'])
            || hasValidModuleFlags(request.resource.data.moduleFlags)
          )
        );
      allow delete: if isAdmin();
    }

    match /dailyCollectionAccounts/{customerId} {
      allow read: if canAccessCustomer(customerId);
      allow create, update: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(customerId, request.auth.uid)
          && request.resource.data.collectorId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /dailyCollections/{collectionId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create: if signedIn()
        && collectionId == request.resource.data.customerId + '_' + request.resource.data.date
        && !exists(/databases/$(database)/documents/dailyCollections/$(collectionId))
        && (
          isAdmin()
          || (
            isCollector()
            && request.resource.data.collectorId == request.auth.uid
            && customerAssignedTo(request.resource.data.customerId, request.auth.uid)
          )
        );
      allow update, delete: if isAdmin();
    }

    match /bachatAccounts/{customerId} {
      allow read: if canAccessCustomer(customerId);
      allow create: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(customerId, request.auth.uid)
          && request.resource.data.collectorId == request.auth.uid
        );
      allow update: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(customerId, request.auth.uid)
          && request.resource.data.collectorId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /bachatCollections/{txId} {
      allow read: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(resource.data.customerId, request.auth.uid)
        );
      allow create: if isAdmin()
        || (
          isCollector()
          && request.resource.data.collectorId == request.auth.uid
          && customerAssignedTo(request.resource.data.customerId, request.auth.uid)
        );
      allow update, delete: if isAdmin();
    }

    match /bachatPenalties/{penaltyId} {
      allow read: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(resource.data.customerId, request.auth.uid)
        );
      allow create, update: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(request.resource.data.customerId, request.auth.uid)
        );
      allow delete: if isAdmin();
    }

    match /bachatClosures/{closureId} {
      allow read: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(resource.data.customerId, request.auth.uid)
        );
      allow create, update, delete: if isAdmin();
    }

    match /bachatSummary/{summaryId} {
      allow read: if isAdmin()
        || (
          isCollector()
          && summaryId == 'main'
        );
      allow create, update: if isAdmin()
        || (
          isCollector()
          && summaryId == 'main'
        );
      allow delete: if isAdmin();
    }

    match /customerFinancials/{customerId} {
      allow read: if canAccessCustomer(customerId);
      allow create, update: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(customerId, request.auth.uid)
        );
      allow delete: if isAdmin();
    }

    match /loanAccounts/{customerId} {
      allow read: if canAccessCustomer(customerId);
      allow create, update: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(customerId, request.auth.uid)
          && request.resource.data.collectorId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /fdAccounts/{customerId} {
      allow read: if canAccessCustomer(customerId);
      allow create, update, delete: if isAdmin();
    }

    match /loans/{loanId} {
      allow read: if isAdmin()
        || (isCollector() && customerAssignedTo(resource.data.customerId, request.auth.uid));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isCollector()
          && customerAssignedTo(resource.data.customerId, request.auth.uid)
          && loanOperationalOnlyChanged()
        );
    }

    match /emiPayments/{paymentId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create: if isAdmin()
        || (
          isCollector()
          && request.resource.data.collectorId == request.auth.uid
          && customerAssignedTo(request.resource.data.customerId, request.auth.uid)
        );
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead',
            'readAt'
          ])
        );
    }

    match /dailySummaries/{summaryId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create, update: if isAdmin()
        || (
          isCollector()
          && request.resource.data.collectorId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /dailyCollectionSummary/{summaryId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create, update: if isAdmin()
        || (
          isCollector()
          && request.resource.data.collectorId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /loanSummary/{summaryId} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /penalties/{penaltyId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.collectorId == request.auth.uid);
      allow create, update: if isAdmin()
        || (
          isCollector()
          && request.resource.data.collectorId == request.auth.uid
          && request.resource.data.type in ['daily', 'emi']
        );
      allow delete: if isAdmin();
    }

    match /financeEntries/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /systemCounters/{counterId} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
